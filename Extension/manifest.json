{
  "manifest_version": 3,
  "key": "",
  "name": "YouPresence",
  "version": "0.1",
  "description": "An enhanced Discord Rich Presence for YouTube",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
